# Example env file for telegram_adapter
TELEGRAM_TOKEN=your-telegram-bot-token-here

# Optional: If you have a running clawd HTTP API, set it like:
# CLAWD_URL=http://localhost:8000/api/reply
# The adapter will POST {"text": "..."} and expects JSON response {"reply": "..."}

# Optional: Or set a local command to call clawd, receives input via stdin and outputs reply on stdout
# CLAWD_CMD=/path/to/clawd-cli --some-flag

# Webhook settings (for production deployment)
# Set a secret token and configure Telegram's setWebhook with the same secret:
# TELEGRAM_WEBHOOK_SECRET=a-long-random-secret
# WEBHOOK_URL=https://yourdomain.com/telegram/webhook
# PORT=8000  # optional, used by docker/uvicorn
